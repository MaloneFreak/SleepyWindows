<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.6.2+ already ships with Windows 10 and 11, so the .exe runs without installing anything. -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SleepyWindows</AssemblyName>
    <RootNamespace>SleepyWindows</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AutomaticallyUseReferenceAssemblyPackages Condition="'$(FrameworkPathOverride)' != ''">false</AutomaticallyUseReferenceAssemblyPackages>

    <Version>1.0.0</Version>
    <Product>SleepyWindows</Product>
    <AssemblyTitle>SleepyWindows</AssemblyTitle>
    <Description>Portable timer to shut down, restart, sleep or hibernate Windows.</Description>
    <Company>MaloneFreak</Company>
    <Copyright>Copyright (c) 2026 MaloneFreak</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- app.ico (above) is the .exe icon shown in Explorer. These two are loaded at runtime:
         a BMP-frame .ico for the window/taskbar and a PNG for the header logo. -->
    <EmbeddedResource Include="assets\window.ico" LogicalName="SleepyWindows.window.ico" />
    <EmbeddedResource Include="assets\logo.png" LogicalName="SleepyWindows.logo.png" />
  </ItemGroup>

  <!-- Lets the project build with the dotnet CLI without Visual Studio installed.
       Skipped when FrameworkPathOverride points at local reference assemblies (e.g. Mono's on Linux). -->
  <ItemGroup Condition="'$(FrameworkPathOverride)' == ''">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
